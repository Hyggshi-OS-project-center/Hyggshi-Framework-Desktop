{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"rootDir": "ts",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": false,
		"types": ["node"],
		"lib": ["ES2022"]
	},
	"include": ["ts"]
}
